{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestre-yoda.dev/schemas/result/v1",
  "title": "Mestre Yoda Universal Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "status",
    "exitCode",
    "reasonCode",
    "summary",
    "why",
    "evidence",
    "stateChanged",
    "retryable",
    "recovery"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "status": { "enum": ["success", "failure", "blocked"] },
    "exitCode": { "type": "integer", "minimum": 0, "maximum": 5 },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
    },
    "summary": { "$ref": "#/$defs/safeLine" },
    "why": {
      "type": "array",
      "items": { "$ref": "#/$defs/safeLine" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "stateChanged": { "type": "boolean" },
    "retryable": { "type": "boolean" },
    "recovery": {
      "oneOf": [{ "$ref": "#/$defs/safeLine" }, { "type": "null" }]
    }
  },
  "$defs": {
    "safeLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\r\\n]+$"
    },
    "safeReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-z][a-z0-9+.-]*://)(?!.*(?:github_pat_|gh[pousr]_))[^\\u0000-\\u001f\\u007f]+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["artifact", "event", "approval", "test", "observation"]
        },
        "ref": { "$ref": "#/$defs/safeReference" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "exitCode": { "const": 0 } },
        "required": ["exitCode"]
      },
      "then": {
        "properties": {
          "status": { "const": "success" },
          "retryable": { "const": false },
          "recovery": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "exitCode": { "enum": [1, 2] } },
        "required": ["exitCode"]
      },
      "then": {
        "properties": {
          "status": { "const": "failure" },
          "why": { "type": "array", "minItems": 1 },
          "recovery": { "$ref": "#/$defs/safeLine" }
        }
      }
    },
    {
      "if": {
        "properties": { "exitCode": { "enum": [3, 4, 5] } },
        "required": ["exitCode"]
      },
      "then": {
        "properties": {
          "status": { "const": "blocked" },
          "why": { "type": "array", "minItems": 1 },
          "recovery": { "$ref": "#/$defs/safeLine" }
        }
      }
    }
  ]
}
