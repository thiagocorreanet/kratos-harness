{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/run-usage/v1",
  "title": "Kratos run usage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "runId",
    "totalGrossTokens",
    "epoch",
    "sessions",
    "measurementFaultAt",
    "updatedAt"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/id" },
    "totalGrossTokens": { "$ref": "#/$defs/count" },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "baselineGrossTokens", "exhaustedAt"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "baselineGrossTokens": { "$ref": "#/$defs/count" },
        "exhaustedAt": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    },
    "sessions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "cumulativeGrossTokens"],
        "properties": {
          "sessionId": { "$ref": "#/$defs/id" },
          "cumulativeGrossTokens": { "$ref": "#/$defs/count" }
        }
      }
    },
    "measurementFaultAt": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "updatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    }
  }
}
