{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/project-config/v1",
  "title": "Kratos project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "pluginVersion",
    "hostContract",
    "language",
    "policyMode",
    "managedState"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "pluginVersion": { "const": "0.3.0" },
    "hostContract": { "const": "1.0.0" },
    "language": { "enum": ["en", "pt-BR"] },
    "policyMode": { "enum": ["standard", "strict"] },
    "managedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "eventLog", "snapshots"],
      "properties": {
        "directory": { "const": ".brain" },
        "eventLog": { "const": "events.jsonl" },
        "snapshots": { "type": "boolean" }
      }
    }
  }
}
