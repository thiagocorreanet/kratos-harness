{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/migration/v1.1",
  "title": "Kratos migration plan or receipt v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "migrationId",
    "sourceContract",
    "destinationContract",
    "planDigest",
    "authorizationRef",
    "backupDigest",
    "status",
    "conversions",
    "verificationRefs",
    "rollback",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contractVersion": { "const": "1.1.0" },
    "stateContract": { "const": "1.1.0" },
    "migrationId": { "$ref": "#/$defs/id" },
    "sourceContract": { "enum": ["0.9.0", "go-v3@0.6.5", "1.0.0"] },
    "destinationContract": { "const": "1.1.0" },
    "planDigest": { "$ref": "#/$defs/sha256" },
    "authorizationRef": { "$ref": "#/$defs/reference" },
    "backupDigest": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": ["planned", "authorized", "completed", "failed", "rolled-back"]
    },
    "conversions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payloadContract", "sourceDigest", "destinationDigest"],
        "properties": {
          "payloadContract": { "$ref": "#/$defs/id" },
          "sourceDigest": { "$ref": "#/$defs/sha256" },
          "destinationDigest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "verificationRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "uniqueItems": true
    },
    "rollback": { "$ref": "#/$defs/rollback" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-z][a-z0-9+.-]*://)[^\\u0000-\\u001f\\u007f]+$"
    },
    "rollback": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "backupRef", "destinationRef"],
          "properties": {
            "kind": { "const": "copy" },
            "backupRef": { "$ref": "#/$defs/reference" },
            "destinationRef": { "$ref": "#/$defs/reference" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "backupRef",
            "backupDigest",
            "destinationRef",
            "destinationDigest"
          ],
          "properties": {
            "kind": { "const": "replace" },
            "backupRef": { "$ref": "#/$defs/reference" },
            "backupDigest": { "$ref": "#/$defs/sha256" },
            "destinationRef": { "$ref": "#/$defs/reference" },
            "destinationDigest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    }
  }
}
