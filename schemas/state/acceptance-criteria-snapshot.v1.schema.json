{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/acceptance-criteria-snapshot/v1",
  "title": "Kratos acceptance criteria snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "runId",
    "eventId",
    "sourceRef",
    "sourceDigest",
    "recordedAt",
    "previousSnapshotRef",
    "declarations"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/id" },
    "eventId": { "$ref": "#/$defs/id" },
    "sourceRef": { "$ref": "#/$defs/reference" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "previousSnapshotRef": {
      "oneOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }]
    },
    "declarations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/declaration" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-z][a-z0-9+.-]*://)[^\\u0000-\\u001f\\u007f]+$"
    },
    "coordinate": { "type": "string", "pattern": "^\\d+$" },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "workUnit",
        "task",
        "kind",
        "ordinal",
        "declarationDigest"
      ],
      "properties": {
        "criterionId": {
          "$ref": "https://kratos.dev/schemas/contracts/acceptance-criterion-id/v1"
        },
        "workUnit": { "$ref": "#/$defs/coordinate" },
        "task": { "$ref": "#/$defs/coordinate" },
        "kind": { "enum": ["main", "edge"] },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "declarationDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
