{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/curated-memory/v1.1",
  "title": "Kratos curated memory v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "revision",
    "projectionDigest",
    "updatedAt",
    "confirmed",
    "archive"
  ],
  "properties": {
    "contractVersion": { "const": "1.1.0" },
    "stateContract": { "const": "1.1.0" },
    "revision": { "$ref": "#/$defs/nonnegativeInteger" },
    "projectionDigest": { "$ref": "#/$defs/sha256" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "confirmed": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/confirmedLesson" }
    },
    "archive": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/legacyArchiveTombstone" },
          { "$ref": "#/$defs/archiveTombstone" }
        ]
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "technology": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._+-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "failureKind": {
      "enum": ["nonzero_exit", "tool_error", "timeout", "denied", "unknown"]
    },
    "dependency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "path" },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-z][a-z0-9+.-]*://)[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:\\d{4}-(?:(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01]))|(?:(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30))|(?:02-(?:0[1-9]|1\\d|2[0-8])))|(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "confirmedLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "title",
        "why",
        "apply",
        "candidateIds",
        "reviewer",
        "confirmedAt",
        "technology",
        "failureKind",
        "dependency",
        "observationCount",
        "firstObservedAt",
        "lastObservedAt"
      ],
      "properties": {
        "lessonId": { "$ref": "#/$defs/sha256" },
        "title": { "$ref": "#/$defs/title" },
        "why": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "apply": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "reviewer": { "$ref": "#/$defs/id" },
        "confirmedAt": { "$ref": "#/$defs/timestamp" },
        "technology": { "$ref": "#/$defs/technology" },
        "failureKind": { "$ref": "#/$defs/failureKind" },
        "dependency": { "$ref": "#/$defs/dependency" },
        "observationCount": { "$ref": "#/$defs/positiveInteger" },
        "firstObservedAt": { "$ref": "#/$defs/timestamp" },
        "lastObservedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "legacyArchiveTombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "title",
        "candidateIds",
        "reviewer",
        "archivedAt",
        "reason",
        "replacementLessonId"
      ],
      "properties": {
        "lessonId": { "$ref": "#/$defs/sha256" },
        "title": { "$ref": "#/$defs/title" },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "reviewer": { "$ref": "#/$defs/id" },
        "archivedAt": { "$ref": "#/$defs/timestamp" },
        "reason": { "$ref": "#/$defs/text" },
        "replacementLessonId": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "archiveTombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "title",
        "candidateIds",
        "reviewer",
        "archivedAt",
        "reason",
        "replacementLessonId",
        "technology",
        "failureKind",
        "dependency",
        "observationCount",
        "firstObservedAt",
        "lastObservedAt",
        "curationEvidence"
      ],
      "properties": {
        "lessonId": { "$ref": "#/$defs/sha256" },
        "title": { "$ref": "#/$defs/title" },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "reviewer": { "$ref": "#/$defs/id" },
        "archivedAt": { "$ref": "#/$defs/timestamp" },
        "reason": { "$ref": "#/$defs/text" },
        "replacementLessonId": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "technology": { "$ref": "#/$defs/technology" },
        "failureKind": { "$ref": "#/$defs/failureKind" },
        "dependency": { "$ref": "#/$defs/dependency" },
        "observationCount": { "$ref": "#/$defs/positiveInteger" },
        "firstObservedAt": { "$ref": "#/$defs/timestamp" },
        "lastObservedAt": { "$ref": "#/$defs/timestamp" },
        "curationEvidence": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policyVersion",
                "proposalId",
                "score",
                "components"
              ],
              "properties": {
                "policyVersion": { "const": "memory-curation/1.0.0" },
                "proposalId": { "$ref": "#/$defs/sha256" },
                "score": { "$ref": "#/$defs/score" },
                "components": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["age", "rarity", "dependencyAbsent"],
                  "properties": {
                    "age": { "$ref": "#/$defs/score" },
                    "rarity": { "$ref": "#/$defs/score" },
                    "dependencyAbsent": { "$ref": "#/$defs/score" }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
