{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/narration/v1",
  "title": "Kratos narration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "runId",
    "generatedAt",
    "beats",
    "pendingProgress"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/id" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "beats": {
      "type": "array",
      "items": { "$ref": "#/$defs/beat" }
    },
    "pendingProgress": {
      "oneOf": [{ "$ref": "#/$defs/clockDerivedProgress" }, { "type": "null" }]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-z][a-z0-9+.-]*://)[^\\u0000-\\u001f\\u007f]+$"
    },
    "clockDerivedProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "eventId",
        "operation",
        "elapsedMs",
        "startedAt",
        "asOf"
      ],
      "properties": {
        "kind": { "const": "in_progress" },
        "eventId": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/id" },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "asOf": { "$ref": "#/$defs/timestamp" }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "beatId",
        "kind",
        "subject",
        "sentence",
        "reasonCode",
        "occurredAt",
        "eventId",
        "revision",
        "facts",
        "evidenceRefs"
      ],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "beatId": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "work",
            "milestone",
            "resumption",
            "warning",
            "waiting",
            "stop"
          ]
        },
        "subject": { "type": "string", "minLength": 1 },
        "sentence": { "type": "string", "minLength": 1 },
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
        },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "eventId": { "$ref": "#/$defs/id" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "facts": { "type": "object" },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" },
          "uniqueItems": true
        }
      }
    }
  }
}
