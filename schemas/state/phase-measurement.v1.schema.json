{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/phase-measurement/v1",
  "title": "Kratos phase measurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "feature",
    "runId",
    "phase",
    "sessionId",
    "correlationId",
    "status",
    "startedAt",
    "endedAt",
    "durationMs",
    "baselineGrossTokens",
    "finalGrossTokens",
    "grossTokens",
    "assignmentDigest",
    "resolvedAssignment",
    "observedIdentity",
    "closeReason",
    "updatedAt"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "feature": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "phase": {
      "enum": ["prd", "spec", "plan", "code", "review", "acceptance"]
    },
    "sessionId": { "$ref": "#/$defs/id" },
    "contributingSessionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "correlationId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["running", "completed", "interrupted"] },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "endedAt": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "durationMs": {
      "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }]
    },
    "baselineGrossTokens": { "$ref": "#/$defs/count" },
    "finalGrossTokens": {
      "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }]
    },
    "grossTokens": { "$ref": "#/$defs/count" },
    "assignmentDigest": { "$ref": "#/$defs/sha256" },
    "resolvedAssignment": { "$ref": "#/$defs/resolvedAssignment" },
    "observedIdentity": { "$ref": "#/$defs/observedIdentity" },
    "closeReason": {
      "oneOf": [
        {
          "enum": [
            "phase_completed",
            "session_interrupted",
            "recovered_completed",
            "recovered_interrupted"
          ]
        },
        { "type": "null" }
      ]
    },
    "updatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "running" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "endedAt": { "type": "null" },
          "durationMs": { "type": "null" },
          "finalGrossTokens": { "type": "null" },
          "closeReason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "endedAt": { "$ref": "#/$defs/timestamp" },
          "durationMs": { "$ref": "#/$defs/count" },
          "finalGrossTokens": { "$ref": "#/$defs/count" },
          "closeReason": { "enum": ["phase_completed", "recovered_completed"] }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "interrupted" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "endedAt": { "$ref": "#/$defs/timestamp" },
          "durationMs": { "$ref": "#/$defs/count" },
          "finalGrossTokens": { "$ref": "#/$defs/count" },
          "closeReason": {
            "enum": ["session_interrupted", "recovered_interrupted"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "resolvedAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "role", "model", "effort"],
      "properties": {
        "host": { "enum": ["claude", "codex"] },
        "role": { "enum": ["planner", "implementer", "judge"] },
        "model": { "$ref": "#/$defs/id" },
        "effort": { "$ref": "#/$defs/id" }
      }
    },
    "observedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "effort": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    }
  }
}
