{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestre-yoda.dev/schemas/state/approval/v1",
  "title": "Mestre Yoda content-bound approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "approvalId",
    "runId",
    "gate",
    "decision",
    "prdDigest",
    "specDigest",
    "policyVersion",
    "approver",
    "observation",
    "challenge",
    "decidedAt"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "approvalId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "gate": { "$ref": "#/$defs/id" },
    "decision": { "enum": ["approved", "rejected"] },
    "prdDigest": { "$ref": "#/$defs/sha256" },
    "specDigest": { "$ref": "#/$defs/sha256" },
    "policyVersion": { "$ref": "#/$defs/id" },
    "approver": { "$ref": "#/$defs/id" },
    "observation": { "$ref": "#/$defs/safeLine" },
    "challenge": { "$ref": "#/$defs/sha256" },
    "decidedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\r\\n]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    }
  }
}
