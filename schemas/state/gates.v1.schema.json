{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/gates/v1",
  "title": "Kratos gate facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "runId",
    "openGaps",
    "openGapIds",
    "stopLoss",
    "partitionRequired",
    "partitionApproved",
    "derivedAt"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/id" },
    "openGaps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "openGapIds": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "stopLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tripped", "exhausted"],
      "properties": {
        "tripped": { "type": "boolean" },
        "exhausted": { "type": "boolean" }
      }
    },
    "partitionRequired": { "type": "boolean" },
    "partitionApproved": { "type": "boolean" },
    "derivedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    }
  }
}
