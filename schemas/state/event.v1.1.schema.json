{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/event/v1.1",
  "title": "Kratos append-only event v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "eventId",
    "eventType",
    "occurredAt",
    "operation",
    "policyVersion",
    "priorRevision",
    "resultingRevision",
    "reasonCode",
    "effect",
    "artifactRefs",
    "evidenceRefs",
    "observedIdentity",
    "previousHash",
    "eventHash"
  ],
  "properties": {
    "contractVersion": { "const": "1.1.0" },
    "stateContract": { "const": "1.1.0" },
    "eventId": { "$ref": "#/$defs/id" },
    "eventType": {
      "enum": ["operation", "decision", "transition", "recovery"]
    },
    "occurredAt": { "$ref": "#/$defs/timestamp" },
    "operation": { "$ref": "#/$defs/id" },
    "policyVersion": { "$ref": "#/$defs/id" },
    "priorRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resultingRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)*$"
    },
    "effect": { "enum": ["none", "state", "artifact", "state-and-artifact"] },
    "artifactRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "uniqueItems": true
    },
    "observedIdentity": { "$ref": "#/$defs/observedIdentity" },
    "resolvedAssignment": { "$ref": "#/$defs/resolvedAssignment" },
    "previousHash": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "eventHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-z][a-z0-9+.-]*://)[^\\u0000-\\u001f\\u007f]+$"
    },
    "observedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "model", "effort"],
      "properties": {
        "host": { "$ref": "#/$defs/id" },
        "model": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "effort": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "resolvedAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "role", "model", "effort"],
      "properties": {
        "phase": {
          "enum": ["prd", "spec", "plan", "code", "review", "acceptance"]
        },
        "role": { "enum": ["planner", "implementer", "judge"] },
        "model": { "$ref": "#/$defs/id" },
        "effort": { "$ref": "#/$defs/id" }
      }
    }
  }
}
