{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/feature-scope/v1",
  "title": "Kratos feature scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "stateContract", "allow", "deny"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "allow": { "$ref": "#/$defs/globs" },
    "deny": { "$ref": "#/$defs/globs" }
  },
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:!(?=.+$))?(?!.*\\\\)(?!.*(?:^|/)\\.\\.?($|/))(?!.*//)(?!.*\\/$)[^!/\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"
    },
    "globs": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/glob" }
    }
  }
}
