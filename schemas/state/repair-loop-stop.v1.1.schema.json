{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/repair-loop-stop/v1.1",
  "title": "Kratos repair loop stop v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "stopId",
    "runId",
    "criterionId",
    "attempt",
    "attemptCeiling",
    "classification",
    "diagnosis",
    "recordedAt"
  ],
  "properties": {
    "contractVersion": { "const": "1.1.0" },
    "stateContract": { "const": "1.1.0" },
    "stopId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "criterionId": {
      "$ref": "https://kratos.dev/schemas/contracts/acceptance-criterion-id/v1"
    },
    "attempt": { "$ref": "#/$defs/positiveInteger" },
    "attemptCeiling": { "$ref": "#/$defs/positiveInteger" },
    "classification": { "enum": ["code", "specification"] },
    "diagnosis": { "$ref": "#/$defs/text" },
    "recordedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    }
  }
}
