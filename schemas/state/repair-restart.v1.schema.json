{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/repair-restart/v1",
  "title": "Kratos specification repair restart ticket v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "ticketId",
    "sourceRunId",
    "nextRunId",
    "resolutionRef",
    "resolutionDigest",
    "retiredCriterionIds",
    "startPhase",
    "createdAt"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "stateContract": { "const": "1.0.0" },
    "ticketId": { "$ref": "#/$defs/id" },
    "sourceRunId": { "$ref": "#/$defs/id" },
    "nextRunId": { "$ref": "#/$defs/id" },
    "resolutionRef": { "$ref": "#/$defs/reference" },
    "resolutionDigest": { "$ref": "#/$defs/sha256" },
    "retiredCriterionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "https://kratos.dev/schemas/contracts/acceptance-criterion-id/v1"
      }
    },
    "startPhase": { "const": "spec" },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-z][a-z0-9+.-]*://)[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
