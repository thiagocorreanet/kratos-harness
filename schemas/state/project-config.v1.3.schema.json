{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/state/project-config/v1.3",
  "title": "Kratos project configuration v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "stateContract",
    "pluginVersion",
    "hostContract",
    "language",
    "policyMode",
    "managedState",
    "modelRoles",
    "projectProfile"
  ],
  "properties": {
    "contractVersion": { "const": "1.3.0" },
    "stateContract": { "const": "1.3.0" },
    "pluginVersion": { "const": "0.0.0-development" },
    "hostContract": { "const": "1.3.0" },
    "language": { "$ref": "#/$defs/languagePolicy" },
    "policyMode": { "enum": ["standard", "strict"] },
    "managedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "eventLog", "snapshots"],
      "properties": {
        "directory": { "const": ".brain" },
        "eventLog": { "const": "events.jsonl" },
        "snapshots": { "type": "boolean" }
      }
    },
    "modelRoles": { "$ref": "#/$defs/modelRoles" },
    "projectProfile": { "$ref": "#/$defs/projectProfile" }
  },
  "$defs": {
    "languageCode": { "enum": ["en", "pt-BR"] },
    "languagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation",
        "documentation",
        "comments",
        "identifiers",
        "commits",
        "preserveConventions",
        "enforcement"
      ],
      "properties": {
        "conversation": { "$ref": "#/$defs/languageCode" },
        "documentation": { "$ref": "#/$defs/languageCode" },
        "comments": { "$ref": "#/$defs/languageCode" },
        "identifiers": { "$ref": "#/$defs/languageCode" },
        "commits": { "$ref": "#/$defs/languageCode" },
        "preserveConventions": { "type": "boolean" },
        "enforcement": { "enum": ["advisory", "off"] }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "assignment": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "effort"],
          "properties": {
            "model": { "$ref": "#/$defs/id" },
            "effort": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "roleMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planner": { "$ref": "#/$defs/assignment" },
        "implementer": { "$ref": "#/$defs/assignment" },
        "judge": { "$ref": "#/$defs/assignment" }
      }
    },
    "modelRoles": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "claude": { "$ref": "#/$defs/roleMap" },
        "codex": { "$ref": "#/$defs/roleMap" },
        "antigravity": { "$ref": "#/$defs/roleMap" }
      }
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\r\\n]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\r\\n]+$"
    },
    "convention": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\r\\n]+$"
    },
    "implementationLanguage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\u0000-\\u001F\\u007F]).+$"
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "unresolved" } }
    },
    "notApplicable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "not-applicable" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "resolvedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "resolved" },
        "value": { "$ref": "#/$defs/command" }
      }
    },
    "resolvedPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "resolved" },
        "value": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectPath" }
        }
      }
    },
    "resolvedConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "resolved" },
        "value": { "$ref": "#/$defs/convention" }
      }
    },
    "resolvedImplementationLanguages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "const": "resolved" },
        "value": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/implementationLanguage" }
        }
      }
    },
    "commandLeaf": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedCommand" },
        { "$ref": "#/$defs/notApplicable" },
        { "$ref": "#/$defs/unresolved" }
      ]
    },
    "pathsLeaf": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedPaths" },
        { "$ref": "#/$defs/notApplicable" },
        { "$ref": "#/$defs/unresolved" }
      ]
    },
    "conventionLeaf": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedConvention" },
        { "$ref": "#/$defs/notApplicable" },
        { "$ref": "#/$defs/unresolved" }
      ]
    },
    "implementationLanguagesLeaf": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedImplementationLanguages" },
        { "$ref": "#/$defs/notApplicable" },
        { "$ref": "#/$defs/unresolved" }
      ]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "lint", "build", "run"],
      "properties": {
        "test": { "$ref": "#/$defs/commandLeaf" },
        "lint": { "$ref": "#/$defs/commandLeaf" },
        "build": { "$ref": "#/$defs/commandLeaf" },
        "run": { "$ref": "#/$defs/commandLeaf" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tests", "configuration"],
      "properties": {
        "source": { "$ref": "#/$defs/pathsLeaf" },
        "tests": { "$ref": "#/$defs/pathsLeaf" },
        "configuration": { "$ref": "#/$defs/pathsLeaf" }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directoryLayout", "naming", "implementationLanguages"],
      "properties": {
        "directoryLayout": { "$ref": "#/$defs/conventionLeaf" },
        "naming": { "$ref": "#/$defs/conventionLeaf" },
        "implementationLanguages": {
          "$ref": "#/$defs/implementationLanguagesLeaf"
        }
      }
    },
    "projectProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "paths", "conventions"],
      "properties": {
        "commands": { "$ref": "#/$defs/commands" },
        "paths": { "$ref": "#/$defs/paths" },
        "conventions": { "$ref": "#/$defs/conventions" }
      }
    }
  }
}
