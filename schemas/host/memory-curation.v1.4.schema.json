{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/host/memory-curation/v1.4",
  "title": "Kratos deterministic memory curation v1.4",
  "oneOf": [{ "$ref": "#/$defs/plan" }, { "$ref": "#/$defs/approval" }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])$"
    },
    "tokenEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intersection", "union"],
      "properties": {
        "intersection": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "union": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "mergeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalId",
        "type",
        "score",
        "lessonIds",
        "components",
        "textEvidence",
        "fixEvidence"
      ],
      "properties": {
        "proposalId": { "$ref": "#/$defs/sha256" },
        "type": { "const": "merge" },
        "score": { "$ref": "#/$defs/score" },
        "lessonIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "fix", "technology", "failureKind"],
          "properties": {
            "text": { "$ref": "#/$defs/score" },
            "fix": { "$ref": "#/$defs/score" },
            "technology": { "$ref": "#/$defs/score" },
            "failureKind": { "$ref": "#/$defs/score" }
          }
        },
        "textEvidence": { "$ref": "#/$defs/tokenEvidence" },
        "fixEvidence": { "$ref": "#/$defs/tokenEvidence" }
      }
    },
    "obsoleteProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "type", "score", "lessonIds", "components"],
      "properties": {
        "proposalId": { "$ref": "#/$defs/sha256" },
        "type": { "enum": ["archive", "delete"] },
        "score": { "$ref": "#/$defs/score" },
        "lessonIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["age", "rarity", "dependencyAbsent"],
          "properties": {
            "age": { "$ref": "#/$defs/score" },
            "rarity": { "$ref": "#/$defs/score" },
            "dependencyAbsent": { "$ref": "#/$defs/score" }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "hostContract",
        "kind",
        "policyVersion",
        "asOf",
        "ledgerDigest",
        "proposals",
        "planDigest"
      ],
      "properties": {
        "contractVersion": { "const": "1.4.0" },
        "hostContract": { "const": "1.4.0" },
        "kind": { "const": "plan" },
        "policyVersion": { "const": "memory-curation/1.0.0" },
        "asOf": { "$ref": "#/$defs/date" },
        "ledgerDigest": { "$ref": "#/$defs/sha256" },
        "proposals": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/mergeProposal" },
              { "$ref": "#/$defs/obsoleteProposal" }
            ]
          }
        },
        "planDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "hostContract",
        "kind",
        "reviewer",
        "planDigest",
        "decisions"
      ],
      "properties": {
        "contractVersion": { "const": "1.4.0" },
        "hostContract": { "const": "1.4.0" },
        "kind": { "const": "approval" },
        "reviewer": { "$ref": "#/$defs/id" },
        "planDigest": { "$ref": "#/$defs/sha256" },
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["proposalId", "decision"],
            "properties": {
              "proposalId": { "$ref": "#/$defs/sha256" },
              "decision": { "enum": ["approve", "reject"] }
            }
          }
        }
      }
    }
  }
}
