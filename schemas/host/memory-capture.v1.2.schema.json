{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/host/memory-capture/v1.2",
  "title": "Kratos memory capture proposal v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "hostContract", "observation"],
  "properties": {
    "contractVersion": { "const": "1.2.0" },
    "hostContract": { "const": "1.2.0" },
    "observation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
