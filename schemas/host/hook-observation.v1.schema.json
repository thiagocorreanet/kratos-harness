{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/host/hook-observation/v1",
  "title": "Kratos normalized hook observation v1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/sessionSample" },
    { "$ref": "#/$defs/toolBefore" },
    { "$ref": "#/$defs/toolFailed" },
    { "$ref": "#/$defs/sessionEnd" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "common": {
      "type": "object",
      "required": [
        "contractVersion",
        "hostContract",
        "kind",
        "sessionId",
        "occurredAt"
      ],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "hostContract": { "const": "1.0.0" },
        "kind": { "type": "string" },
        "sessionId": { "$ref": "#/$defs/id" },
        "occurredAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cumulativeGrossTokens"],
      "properties": {
        "cumulativeGrossTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "mutation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "enum": ["create", "update", "delete"] },
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "destination"],
          "properties": {
            "kind": { "const": "move" },
            "source": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "destination": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      ]
    },
    "sessionSample": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "session.sample" },
            "usage": { "$ref": "#/$defs/usage" }
          },
          "required": ["usage"]
        }
      ],
      "unevaluatedProperties": false
    },
    "toolBefore": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "tool.before" },
            "toolUseId": { "$ref": "#/$defs/id" },
            "mutations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "#/$defs/mutation" }
            }
          },
          "required": ["toolUseId", "mutations"]
        }
      ],
      "unevaluatedProperties": false
    },
    "toolFailed": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "tool.failed" },
            "toolUseId": { "$ref": "#/$defs/id" },
            "toolFamily": {
              "enum": ["file", "shell", "mcp", "search", "other"]
            },
            "failureClass": {
              "enum": [
                "nonzero_exit",
                "tool_error",
                "timeout",
                "denied",
                "unknown"
              ]
            },
            "exitCode": {
              "oneOf": [
                { "type": "integer", "minimum": 0, "maximum": 255 },
                { "type": "null" }
              ]
            },
            "diagnostic": { "type": "string", "maxLength": 2048 },
            "usage": {
              "oneOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }]
            }
          },
          "required": [
            "toolUseId",
            "toolFamily",
            "failureClass",
            "exitCode",
            "diagnostic",
            "usage"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "sessionEnd": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "session.end" },
            "usage": {
              "oneOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }]
            }
          },
          "required": ["usage"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
