{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/host/agent-output/v1.2",
  "title": "Kratos agent output v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "hostContract",
    "agent",
    "outcome",
    "artifacts",
    "changedFiles",
    "payload",
    "memory"
  ],
  "properties": {
    "contractVersion": { "const": "1.2.0" },
    "hostContract": { "const": "1.2.0" },
    "agent": {
      "enum": ["prd", "spec", "plan", "code", "review", "acceptance"]
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "changedFiles": { "$ref": "#/$defs/changedFiles" },
    "payload": { "type": "object" },
    "memory": { "$ref": "#/$defs/memory" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "agent": { "const": "prd" } },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/prdPayload" },
          "memory": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "agent": { "const": "spec" } },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/specPayload" },
          "memory": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "agent": { "const": "plan" } },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/planPayload" },
          "memory": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "agent": { "const": "code" } },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/codePayload" },
          "memory": { "$ref": "#/$defs/memoryObservation" }
        }
      }
    },
    {
      "if": {
        "properties": { "agent": { "const": "review" } },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/reviewPayload" },
          "memory": { "$ref": "#/$defs/memoryObservation" }
        }
      }
    },
    {
      "if": {
        "properties": { "agent": { "const": "acceptance" } },
        "required": ["agent"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/acceptancePayload" },
          "memory": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/id"
    },
    "text": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/text"
    },
    "reference": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/reference"
    },
    "outcome": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/outcome"
    },
    "artifacts": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/artifacts"
    },
    "changedFiles": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/changedFiles"
    },
    "prdPayload": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/prdPayload"
    },
    "specPayload": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/specPayload"
    },
    "planPayload": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/planPayload"
    },
    "codePayload": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/codePayload"
    },
    "reviewPayload": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/reviewPayload"
    },
    "acceptancePayload": {
      "$ref": "https://kratos.dev/schemas/host/agent-output/v1#/$defs/acceptancePayload"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "memory": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/memoryObservation" }]
    },
    "memoryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "lessonIds"],
      "properties": {
        "ref": { "const": ".brain/03-memory/gotchas.md" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "lessonIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  }
}
