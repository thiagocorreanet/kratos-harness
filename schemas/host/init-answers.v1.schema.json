{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mestre-yoda.dev/schemas/host/init-answers/v1",
  "title": "Mestre Yoda initialization answers v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "hostContract", "hosts"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "hostContract": { "const": "1.0.0" },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex"] }
    },
    "language": { "enum": ["en", "pt-BR"] },
    "policyMode": { "enum": ["standard", "strict"] },
    "snapshots": { "type": "boolean" }
  }
}
