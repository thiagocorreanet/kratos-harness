{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kratos.dev/schemas/host/pre-tool-use/v1",
  "title": "Kratos pre-tool use v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "hostContract", "operation", "targets"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "hostContract": { "const": "1.0.0" },
    "operation": { "enum": ["create", "update", "delete", "move"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "move" } },
        "required": ["operation"]
      },
      "then": {
        "properties": { "targets": { "type": "array", "minItems": 2 } }
      }
    }
  ],
  "$defs": {
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
